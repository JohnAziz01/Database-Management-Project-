# Copy to testing/.env.test (run_tests.ps1 does this for you the first time).
# The database below is WIPED before every test. It must NOT be the database
# in backend/.env -- the test suite refuses to run if they match.
TEST_DATABASE_URL=postgresql+psycopg2://postgres:testpass@127.0.0.1:5544/autorisk_test

# Ports the end-to-end (browser) tests start their own servers on, so they
# never collide with an app you already have running on 8000 / 5173.
E2E_API_PORT=8001
E2E_WEB_PORT=5174

# Set to 1 to watch the browser tests run in a visible window.
E2E_HEADED=0
